# ==============================================================================
# CollabSpace Server Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Cryptographic Authentication Secrets
AUTH_SECRET=collabspace_super_secret_jwt_key_change_in_production_min32chars
TOKEN_EXPIRY=7d

# File Storage Configuration (Local Driver vs S3 Driver)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# Optional S3 Storage Driver (When migrating to Cloud Object Storage)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=collabspace-production-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Database Configuration (SQLite local driver vs PostgreSQL)
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/collabspace.db
# DATABASE_URL=postgresql://user:password@localhost:5432/collabspace

# Realtime WebRTC Infrastructure
# Pre-configured public STUN servers for standard NAT discovery
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Enterprise TURN Server Configuration (Required for Symmetric NAT Traversal)
# TURN_SERVER_URL=turn:turn.collabspace.io:3478
# TURN_USERNAME=collabspace_turn_user
# TURN_CREDENTIAL=collabspace_turn_secret_credential
